# Copie para .env e troque os valores: cp .env.example .env

# Senha do usuário postgres (banco "alertas")
PG_SENHA=troque-esta-senha

# Chave que o ESP32 envia no cabeçalho x-api-key
API_KEY=troque-esta-chave

# Segredo usado para anonimizar o identificador do dispositivo (HMAC-SHA256)
SALT_DISPOSITIVO=troque-este-segredo

# Identificador e posição usados quando o firmware não os envia
DISPOSITIVO_PADRAO=esp32-01
LAT_SENSOR=-22.5050
LON_SENSOR=-43.1800

# Só para rodar a API fora do Docker (no compose estes dois já vêm prontos)
DATABASE_URL=postgresql+psycopg://postgres:troque-esta-senha@localhost:5433/alertas
NOS_URL=http://localhost:8081,http://localhost:8082,http://localhost:8083
